<!-- 小车倒立摆场景：地面、光照 + 引入机器人描述 -->
<mujoco model="cartpole_scene">
  <include file="robot_description.xml"/>

  <statistic center="0 0 0.95" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.18 0.22 1"/>
    <global azimuth="90" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.45 0.55"
             rgb2="0.05 0.08 0.12" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" mark="edge"
             rgb1="0.25 0.25 0.28" rgb2="0.32 0.32 0.35"
             markrgb="0.4 0.4 0.42" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8"
              reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="4 4 0.05" material="grid"
          contype="0" conaffinity="0" condim="1"/>
  </worldbody>
</mujoco>
